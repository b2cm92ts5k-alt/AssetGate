{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-gate/config.schema.json",
  "title": "Asset Gate config",
  "type": "object",
  "required": [
    "schema",
    "mesh",
    "naming",
    "material",
    "texture",
    "texelDensity",
    "fbx",
    "unity",
    "collider",
    "pack",
    "marketing"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "mesh": {
      "type": "object",
      "required": [
        "mergeDistance",
        "degenerateThreshold"
      ],
      "additionalProperties": false,
      "properties": {
        "mergeDistance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "degenerateThreshold": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "naming": {
      "type": "object",
      "required": [
        "pattern",
        "defaultNameBlocklist"
      ],
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "type": "string",
          "format": "regex"
        },
        "defaultNameBlocklist": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "regex"
          },
          "uniqueItems": true
        }
      }
    },
    "material": {
      "type": "object",
      "required": [
        "maxWithoutReview"
      ],
      "additionalProperties": false,
      "properties": {
        "maxWithoutReview": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "texture": {
      "type": "object",
      "required": [
        "allowedSizes"
      ],
      "additionalProperties": false,
      "properties": {
        "allowedSizes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "texelDensity": {
      "type": "object",
      "required": [
        "tolerancePercent"
      ],
      "additionalProperties": false,
      "properties": {
        "tolerancePercent": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "fbx": {
      "type": "object",
      "required": [
        "forward",
        "up",
        "unitScale",
        "embedTextures"
      ],
      "additionalProperties": false,
      "properties": {
        "forward": {
          "$ref": "#/$defs/axis"
        },
        "up": {
          "$ref": "#/$defs/axis"
        },
        "unitScale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "embedTextures": {
          "type": "boolean"
        }
      }
    },
    "unity": {
      "type": "object",
      "required": [
        "minEditorVersion",
        "export",
        "textureRoles",
        "testScene",
        "shader",
        "colorSpace",
        "materialsLocation",
        "modelImport"
      ],
      "additionalProperties": false,
      "properties": {
        "minEditorVersion": {
          "description": "Export to Unity accepts projects of this Unity version or newer (SPEC D24)",
          "type": "string",
          "pattern": "^[0-9]{4}\\.[0-9]+$"
        },
        "editorVersion": {
          "description": "Deprecated (exact version lock before SPEC D24); ignored, kept so older config.json files stay valid",
          "type": "string",
          "minLength": 1
        },
        "export": {
          "type": "object",
          "required": [
            "meshFolder",
            "textureFolder",
            "materialFolder",
            "prefabFolder"
          ],
          "additionalProperties": false,
          "properties": {
            "meshFolder": {
              "type": "string",
              "minLength": 1
            },
            "textureFolder": {
              "type": "string",
              "minLength": 1
            },
            "materialFolder": {
              "type": "string",
              "minLength": 1
            },
            "prefabFolder": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "shader": {
          "type": "string",
          "minLength": 1
        },
        "colorSpace": {
          "enum": [
            "Linear",
            "Gamma"
          ]
        },
        "materialsLocation": {
          "enum": [
            "External",
            "InPrefab"
          ]
        },
        "modelImport": {
          "type": "object",
          "required": [
            "scaleFactor",
            "normals",
            "tangents",
            "meshCompression",
            "readWrite"
          ],
          "additionalProperties": false,
          "properties": {
            "scaleFactor": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "normals": {
              "enum": [
                "Import",
                "Calculate",
                "None"
              ]
            },
            "tangents": {
              "enum": [
                "Import",
                "Calculate",
                "None"
              ]
            },
            "meshCompression": {
              "enum": [
                "Off",
                "Low",
                "Medium",
                "High"
              ]
            },
            "readWrite": {
              "type": "boolean"
            }
          }
        },
        "textureRoles": {
          "type": "object",
          "required": [
            "baseMap",
            "normalMap",
            "metallicRoughness"
          ],
          "additionalProperties": false,
          "properties": {
            "baseMap": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "normalMap": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "metallicRoughness": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "testScene": {
          "type": "object",
          "required": [
            "width",
            "height",
            "yaw",
            "pitch",
            "lightRotation",
            "lightIntensity"
          ],
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "yaw": {
              "type": "number"
            },
            "pitch": {
              "type": "number"
            },
            "lightRotation": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "lightIntensity": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "collider": {
      "type": "object",
      "required": [
        "boundsTolerancePercent"
      ],
      "additionalProperties": false,
      "properties": {
        "boundsTolerancePercent": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "pack": {
      "type": "object",
      "required": [
        "maxPathLength",
        "folders",
        "demoFolder",
        "readmeNames",
        "docExtensions",
        "noticesName"
      ],
      "additionalProperties": false,
      "properties": {
        "maxPathLength": {
          "type": "integer",
          "minimum": 1
        },
        "folders": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "demoFolder": {
          "type": "string",
          "minLength": 1
        },
        "readmeNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "docExtensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\.[a-z0-9]+$"
          }
        },
        "noticesName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "marketing": {
      "type": "object",
      "required": [
        "icon",
        "card",
        "cover",
        "social",
        "screenshots",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "icon": {
          "$ref": "#/$defs/imageSize"
        },
        "card": {
          "$ref": "#/$defs/imageSize"
        },
        "cover": {
          "$ref": "#/$defs/imageSize"
        },
        "social": {
          "$ref": "#/$defs/imageSize"
        },
        "screenshots": {
          "type": "object",
          "required": [
            "min",
            "max",
            "aspect",
            "format",
            "alpha"
          ],
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 1
            },
            "aspect": {
              "type": "string",
              "pattern": "^[1-9]\\d*:[1-9]\\d*$"
            },
            "format": {
              "enum": [
                "PNG",
                "JPG"
              ]
            },
            "alpha": {
              "type": "boolean"
            }
          }
        },
        "files": {
          "type": "object",
          "required": [
            "icon",
            "card",
            "cover",
            "social",
            "screenshotPrefix"
          ],
          "additionalProperties": false,
          "properties": {
            "icon": {
              "type": "string",
              "minLength": 1
            },
            "card": {
              "type": "string",
              "minLength": 1
            },
            "cover": {
              "type": "string",
              "minLength": 1
            },
            "social": {
              "type": "string",
              "minLength": 1
            },
            "screenshotPrefix": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "polycount": {
      "description": "Triangle-count guidance per model (SPEC D22). Advice only: m1-16 is always review. Optional — tools fall back to the default config.",
      "type": "object",
      "required": [
        "tiers",
        "byType",
        "vrUses",
        "vrSceneBudget"
      ],
      "additionalProperties": false,
      "properties": {
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "key",
              "max"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "enum": [
                  "low",
                  "mid",
                  "high",
                  "veryHigh"
                ]
              },
              "max": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              }
            }
          }
        },
        "byType": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "smallProp",
              "mediumProp",
              "building",
              "foliage",
              "character",
              "npc",
              "vehicle",
              "heroProp"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "mobile": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              },
              "pc": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        "vrUses": {
          "enum": [
            "mobile",
            "pc"
          ]
        },
        "vrSceneBudget": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "axis": {
      "enum": [
        "X",
        "-X",
        "Y",
        "-Y",
        "Z",
        "-Z"
      ]
    },
    "imageSize": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    }
  }
}
